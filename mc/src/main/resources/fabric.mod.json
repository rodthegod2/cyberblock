{
	"schemaVersion": 1,
	"id": "cyberblock",
	"version": "${version}",
	"name": "Cyberblock",
	"description": "Runs alongside Cyberpunk 2077: its camera drives Minecraft's, its collision becomes invisible blocks, and Minecraft's picture (colour + depth) is handed back to be composited into the game. Based on universal-modder (MIT) by Rehan.",
	"authors": [
		"Cyberblock",
		"Rehan (universal-modder)"
	],
	"license": "MIT",
	"icon": "assets/cyberblock/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.cyberblock.Cyberblock",
			"dev.cyberblock.cyber.CyberMod",
			"dev.cyberblock.hub.HubMod",
			"dev.cyberblock.mode.match.MatchMod"
		],
		"client": [
			"dev.cyberblock.client.CyberblockClient",
			"dev.cyberblock.client.cyber.CyberClient",
			"dev.cyberblock.client.ui.UiClient",
			"dev.cyberblock.client.hub.HubClient",
			"dev.cyberblock.client.mode.match.MatchClient"
		]
	},
	"mixins": [
		"cyberblock.mixins.json",
		{
			"config": "cyberblock.client.mixins.json",
			"environment": "client"
		},
		"cyberblock.cyber.mixins.json",
		{
			"config": "cyberblock.cyber.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "cyberblock.ui.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	}
}
